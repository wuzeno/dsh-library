{
  "name": "dsh-library",
  "version": "1.0.0",
  "description": "每个工作区自动建一个资料库，统一放在你选定的本机位置；在「资料库」菜单里集中管理，任意格式文件都能导入，原件只复制不改来源。对话中可随时选择是否参考资料库。",
  "homepage": "https://github.com/wuzeno/dsh-library#readme",
  "repository": { "type": "git", "url": "git+https://github.com/wuzeno/dsh-library.git" },
  "bugs": { "url": "https://github.com/wuzeno/dsh-library/issues" },
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=22.13.0", "dsh": ">=0.2.1-rc.3 <0.3.0" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "client.js", "src/**/*.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "CHANGELOG.md", "SECURITY.md", "docs/**/*.md", "docs/images/*.jpg"],
  "scripts": { "test": "node --test --test-isolation=none", "check": "node scripts/check.mjs", "test:all": "node scripts/check.mjs && node --test --test-isolation=none" },
  "dependencies": { "zod": "^4.1.0" },
  "devDependencies": { "mammoth": "^1.9.1", "pdfjs-dist": "4.10.38" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation"] } }
}
